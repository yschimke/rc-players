{
  "name": "expr_physics_trajectory",
  "category": "expressions",
  "description": "Kinematic equations for 2D ballistic trajectory and kinetic energy",
  "parameters": {
    "tolerance": 0.01
  },
  "document": {
    "header": {
      "width": 100,
      "height": 100,
      "contentDescription": "expr_physics_trajectory",
      "profiles": 513
    },
    "resources": {
      "variables": [
        {
          "name": "t",
          "value": "2.5",
          "export": true
        },
        {
          "name": "v0",
          "value": "40.0",
          "export": true
        },
        {
          "name": "g",
          "value": "9.8",
          "export": true
        },
        {
          "name": "mass",
          "value": "2.0",
          "export": true
        },
        {
          "name": "x_pos",
          "value": "v0 * 0.866025 * t",
          "export": true
        },
        {
          "name": "y_pos",
          "value": "v0 * 0.5 * t - 0.5 * g * t * t",
          "export": true
        },
        {
          "name": "vy_curr",
          "value": "v0 * 0.5 - g * t",
          "export": true
        },
        {
          "name": "speed_sqr",
          "value": "square(v0 * 0.866025) + square(vy_curr)",
          "export": true
        },
        {
          "name": "kinetic_energy",
          "value": "0.5 * mass * speed_sqr",
          "export": true
        }
      ]
    },
    "root": {
      "type": "box"
    }
  }
}
