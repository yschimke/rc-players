{
  "name": "row_spaced_by",
  "description": "Row layout with spacedBy modifier distributing inter-item gaps",
  "parameters": {
    "width": 400,
    "height": 150,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 400,
        "height": 150,
        "label": "initial (400x150)"
      },
      {
        "step": 1,
        "width": 800,
        "height": 300,
        "label": "doubled (800x300)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 400,
      "height": 150
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "spacedBy": 20.0
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 60
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
