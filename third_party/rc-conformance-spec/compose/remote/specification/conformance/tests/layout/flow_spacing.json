{
  "name": "flow_spacing",
  "description": "Flow layout with row and column spacedBy spacing",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 300,
        "label": "initial (300x300)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 600,
        "label": "doubled (600x600)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300
    },
    "root": {
      "type": "flow",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "spacedBy": 12.0
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#fcd34d"
            }
          ]
        }
      ]
    }
  }
}
