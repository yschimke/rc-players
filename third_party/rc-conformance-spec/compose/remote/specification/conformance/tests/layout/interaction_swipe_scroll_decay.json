{
  "name": "interaction_swipe_scroll_decay",
  "description": "Column vertical swipe gesture with fling velocity and inertial decay deceleration",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1.0,
    "tolerance": 1.0,
    "frames": 2,
    "interactions": [
      {
        "step": 0,
        "type": "touch_down",
        "x": 150,
        "y": 250,
        "label": "touch_down"
      },
      {
        "step": 1,
        "type": "touch_drag",
        "x": 150,
        "y": 150,
        "time_millis": 20,
        "label": "drag_up_100px"
      },
      {
        "step": 2,
        "type": "touch_up",
        "x": 150,
        "y": 150,
        "dx": 0,
        "dy": -1200,
        "time_millis": 20,
        "label": "fling_release_1200pxs"
      },
      {
        "step": 3,
        "type": "advance_time",
        "delta_millis": 100,
        "label": "decay_100ms"
      },
      {
        "step": 4,
        "type": "advance_time",
        "delta_millis": 200,
        "label": "decay_300ms"
      },
      {
        "step": 5,
        "type": "advance_time",
        "delta_millis": 300,
        "label": "decay_600ms"
      },
      {
        "step": 6,
        "type": "advance_time",
        "delta_millis": 500,
        "label": "decay_1100ms_stopped"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "verticalScroll": {
            "position": 0.0,
            "notches": 0
          }
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 200
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 200
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 200
            },
            {
              "background": "#86efac"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 200
            },
            {
              "background": "#fcd34d"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 200
            },
            {
              "background": "#d8b4fe"
            }
          ]
        }
      ]
    }
  }
}
