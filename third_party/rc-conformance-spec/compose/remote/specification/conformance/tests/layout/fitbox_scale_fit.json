{
  "name": "fitbox_scale_fit",
  "description": "FitBox container with aspect-ratio fitted child box",
  "parameters": {
    "width": 200,
    "height": 100,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 100,
        "label": "initial (200x100)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 200,
        "label": "doubled (400x200)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 100,
      "contentDescription": "fitbox_scale_fit",
      "profiles": 513
    },
    "root": {
      "type": "fitBox",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": [
                100,
                100
              ]
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
