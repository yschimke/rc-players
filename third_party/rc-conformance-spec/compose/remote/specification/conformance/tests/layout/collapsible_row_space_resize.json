{
  "name": "collapsible_row_space_resize",
  "description": "CollapsibleRow dynamically collapsing children as width shrinks and uncollapsing as width expands",
  "parameters": {
    "width": 350,
    "height": 100,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 350,
        "height": 100,
        "label": "all fit (350x100)"
      },
      {
        "step": 1,
        "width": 220,
        "height": 100,
        "label": "lowest collapses (220x100)"
      },
      {
        "step": 2,
        "width": 120,
        "height": 100,
        "label": "two lowest collapse (120x100)"
      },
      {
        "step": 3,
        "width": 50,
        "height": 100,
        "label": "container collapses (50x100)"
      },
      {
        "step": 4,
        "width": 350,
        "height": 100,
        "label": "uncollapsed back (350x100)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 350,
      "height": 100
    },
    "root": {
      "type": "collapsibleRow",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            },
            {
              "collapsiblePriority": 100
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            },
            {
              "collapsiblePriority": 50
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            },
            {
              "collapsiblePriority": 10
            }
          ]
        }
      ]
    }
  }
}
