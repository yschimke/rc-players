{
  "name": "animation_box_offset",
  "description": "Multi-frame bounds animation interpolating Box dimensions and child centered position across 4 motion frames",
  "parameters": {
    "width": 100,
    "height": 100,
    "density": 1,
    "tolerance": 0.5,
    "frames": 2,
    "animation": {
      "trigger": {
        "type": "resize",
        "width": 300,
        "height": 200
      },
      "capture_frames": [
        0,
        5,
        10,
        18
      ],
      "total_frames": 18
    }
  },
  "document": {
    "header": {
      "width": 100,
      "height": 100,
      "contentDescription": "animation_box_offset",
      "profiles": 513
    },
    "root": {
      "type": "box",
      "horizontalAlignment": "center",
      "verticalAlignment": "center",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        },
        {
          "animationSpec": 100
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 50
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            },
            {
              "animationSpec": 100
            }
          ]
        }
      ]
    }
  }
}
