{
  "name": "modifier_visibility_invisible",
  "description": "Row layout where a child with visibility invisible retains its measured space",
  "parameters": {
    "width": 300,
    "height": 100,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 100,
        "label": "initial (300x100)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 200,
        "label": "doubled (600x200)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 100
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 80
            },
            {
              "background": "#fca5a5"
            },
            {
              "visibility": "invisible"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
