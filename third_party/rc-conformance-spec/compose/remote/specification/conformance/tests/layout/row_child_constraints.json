{
  "name": "row_child_constraints",
  "description": "Row children with widthIn and heightIn constraints",
  "parameters": {
    "width": 300,
    "height": 120,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 120,
        "label": "initial (300x120)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 240,
        "label": "doubled (600x240)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 120,
      "contentDescription": "row_child_constraints",
      "profiles": 513
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "widthIn": {
                "min": 50,
                "max": 100
              }
            },
            {
              "height": 40
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "widthIn": {
                "min": 60,
                "max": 120
              }
            },
            {
              "height": 40
            },
            {
              "background": "#fca5a5"
            }
          ]
        }
      ]
    }
  }
}
