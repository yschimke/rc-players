{
  "name": "core_text_alignment",
  "description": "CoreText text alignment across start, center, and end alignments",
  "parameters": {
    "width": 300,
    "height": 150,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 150,
        "label": "initial (300x150)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 300,
        "label": "doubled (600x300)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 150,
      "profiles": 513
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "text",
          "text": "Left Text",
          "fontSize": 16,
          "textAlign": "start",
          "modifiers": [
            {
              "fillMaxWidth": 1.0
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "text",
          "text": "Center Text",
          "fontSize": 16,
          "textAlign": "center",
          "modifiers": [
            {
              "fillMaxWidth": 1.0
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "text",
          "text": "Right Text",
          "fontSize": 16,
          "textAlign": "end",
          "modifiers": [
            {
              "fillMaxWidth": 1.0
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
