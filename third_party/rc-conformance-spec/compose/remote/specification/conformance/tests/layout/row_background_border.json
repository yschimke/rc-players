{
  "name": "row_background_border",
  "description": "Row container with background and border styling",
  "parameters": {
    "width": 300,
    "height": 120,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 120,
        "label": "initial (300x120)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 240,
        "label": "doubled (600x240)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 120
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "border": {
            "width": 2.0,
            "cornerRadius": 8.0,
            "color": "#64748b"
          }
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
