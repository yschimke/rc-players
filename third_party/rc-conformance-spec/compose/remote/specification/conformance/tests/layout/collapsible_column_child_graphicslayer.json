{
  "name": "collapsible_column_child_graphicslayer",
  "description": "CollapsibleColumn items with graphicsLayer transformations",
  "parameters": {
    "width": 150,
    "height": 260,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 150,
        "height": 260,
        "label": "initial (150x260)"
      },
      {
        "step": 1,
        "width": 300,
        "height": 520,
        "label": "doubled (300x520)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 150,
      "height": 260
    },
    "root": {
      "type": "collapsibleColumn",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": [
                60,
                40
              ]
            },
            {
              "background": "#93c5fd"
            },
            {
              "graphicsLayer": {
                "scaleX": 1.1,
                "scaleY": 1.1,
                "alpha": 0.8
              }
            },
            {
              "collapsiblePriority": 1
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": [
                60,
                40
              ]
            },
            {
              "background": "#fca5a5"
            },
            {
              "collapsiblePriority": 2
            }
          ]
        }
      ]
    }
  }
}
