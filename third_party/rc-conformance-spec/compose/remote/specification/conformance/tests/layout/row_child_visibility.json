{
  "name": "row_child_visibility",
  "description": "Row children with explicit visibility states",
  "parameters": {
    "width": 300,
    "height": 120,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 120,
        "label": "initial (300x120)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 240,
        "label": "doubled (600x240)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 120
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 40
            },
            {
              "background": "#93c5fd"
            },
            {
              "visibility": "visible"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 40
            },
            {
              "background": "#fca5a5"
            },
            {
              "visibility": "gone"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 40
            },
            {
              "background": "#86efac"
            },
            {
              "visibility": "invisible"
            }
          ]
        }
      ]
    }
  }
}
