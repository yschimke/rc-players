{
  "name": "modifier_border",
  "description": "Box with border modifier specifying stroke width, corner radius, and color",
  "parameters": {
    "width": 300,
    "height": 200,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 200,
        "label": "initial (300x200)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 400,
        "label": "doubled (600x400)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 200
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 160
            },
            {
              "height": 100
            },
            {
              "background": "#93c5fd"
            },
            {
              "border": {
                "width": 4.0,
                "cornerRadius": 8.0,
                "color": "#ff0000"
              }
            }
          ]
        }
      ]
    }
  }
}
