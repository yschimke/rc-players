{
  "name": "collapsible_row_spacing_collapse",
  "description": "CollapsibleRow with spacedBy where overflowing child is marked GONE and remaining visible children use spacing",
  "parameters": {
    "width": 220,
    "height": 100,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5
  },
  "document": {
    "header": {
      "width": 220,
      "height": 100
    },
    "root": {
      "type": "collapsibleRow",
      "spacedBy": 20,
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            },
            {
              "collapsiblePriority": 100
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            },
            {
              "collapsiblePriority": 50
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            },
            {
              "collapsiblePriority": 10
            }
          ]
        }
      ]
    }
  }
}
