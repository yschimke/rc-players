{
  "name": "row_fill_max_height",
  "description": "Row with children filling parent maximum height",
  "parameters": {
    "width": 300,
    "height": 200,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 200,
        "label": "initial (300x200)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 400,
        "label": "doubled (600x400)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 200,
      "contentDescription": "row_fill_max_height",
      "profiles": 513
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 60
            },
            {
              "fillMaxHeight": 1
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "fillMaxHeight": 0.5
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 60
            },
            {
              "height": 80
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
