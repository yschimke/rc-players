    "width": 400,
    "height": 300,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 400,
        "height": 300,
        "label": "initial (400x300)"
      },
      {
        "step": 1,
        "width": 800,
        "height": 600,
        "label": "doubled (800x600)"
      }
    ]
  },
  "document": {
