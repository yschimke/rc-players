          "type": "box",
          "modifiers": [
            {
              "width": 50
            },
            {
              "widthIn": {
                "min": 100,
                "max": 200
              }
            },
            {
              "height": 80
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 300
            },
            {
              "widthIn": {
                "min": 50,
                "max": 120
              }
            },
            {
              "height": 80
            },
            {
              "background": "#fca5a5"
            }
          ]
        }
      ]
    }
  }
}
