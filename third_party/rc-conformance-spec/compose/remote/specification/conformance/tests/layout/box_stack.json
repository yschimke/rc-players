{
  "name": "box_stack",
  "description": "Box container stacking overlapping children with distinct alignments",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 300,
        "label": "initial (300x300)"
      },
      {
        "step": 1,
        "width": 600,
        "height": 600,
        "label": "doubled (600x600)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300,
      "contentDescription": "box_stack",
      "profiles": 513
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "fillMaxSize": 1
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 120
            },
            {
              "height": 120
            },
            {
              "background": "#fca5a5"
            }
          ]
        }
      ]
    }
  }
}
