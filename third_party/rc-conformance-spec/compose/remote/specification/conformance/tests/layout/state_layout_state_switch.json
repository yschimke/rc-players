{
  "name": "state_layout_state_switch",
  "category": "layout",
  "description": "StateLayout bounds follow the selected child across state changes. Each click selects a differently sized child; the click step captures the resize still in flight (the container animates rather than snapping) and the settle step that follows captures it landed exactly on the new child's size.",
  "parameters": {
    "width": 400,
    "height": 300,
    "density": 1.0,
    "tolerance": 0.5,
    "frames": 2,
    "interactions": [
      {
        "step": 0,
        "type": "click",
        "x": 90,
        "y": 15,
        "label": "select_page_1"
      },
      {
        "step": 1,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_on_page_1_180x90"
      },
      {
        "step": 2,
        "type": "click",
        "x": 150,
        "y": 15,
        "label": "select_page_2"
      },
      {
        "step": 3,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_on_page_2_120x150"
      },
      {
        "step": 4,
        "type": "click",
        "x": 30,
        "y": 15,
        "label": "back_to_page_0"
      },
      {
        "step": 5,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_on_page_0_60x40"
      }
    ]
  },
  "document": {
    "header": {
      "width": 400,
      "height": 300
    },
    "resources": {
      "variables": {
        "page": {
          "type": "integer",
          "value": 0
        }
      }
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "row",
          "modifiers": [
            {
              "fillMaxWidth": 1.0
            },
            {
              "height": 30
            },
            {
              "background": "#1e3a8a"
            }
          ],
          "children": [
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 60
                },
                {
                  "height": 30
                },
                {
                  "background": "#93c5fd"
                },
                {
                  "onClick": {
                    "type": "valueIntegerChange",
                    "target": "page",
                    "value": 0
                  }
                }
              ]
            },
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 60
                },
                {
                  "height": 30
                },
                {
                  "background": "#fca5a5"
                },
                {
                  "onClick": {
                    "type": "valueIntegerChange",
                    "target": "page",
                    "value": 1
                  }
                }
              ]
            },
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 60
                },
                {
                  "height": 30
                },
                {
                  "background": "#86efac"
                },
                {
                  "onClick": {
                    "type": "valueIntegerChange",
                    "target": "page",
                    "value": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "stateLayout",
          "stateId": "$page",
          "children": [
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 60
                },
                {
                  "height": 40
                },
                {
                  "background": "#93c5fd"
                }
              ]
            },
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 180
                },
                {
                  "height": 90
                },
                {
                  "background": "#fca5a5"
                }
              ]
            },
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 120
                },
                {
                  "height": 150
                },
                {
                  "background": "#86efac"
                }
              ]
            }
          ],
          "modifiers": [
            {
              "background": "#14532d"
            }
          ]
        }
      ]
    }
  }
}
