{
  "name": "flow_item_alignment",
  "description": "Flow layout with vertical center alignment for varying item heights",
  "parameters": {
    "width": 200,
    "height": 180,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 180,
        "label": "initial (200x180)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 360,
        "label": "doubled (400x360)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 180,
      "contentDescription": "flow_item_alignment",
      "profiles": 513
    },
    "root": {
      "type": "flow",
      "verticalAlignment": "center",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 50
            },
            {
              "height": 30
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 60
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 50
            },
            {
              "height": 40
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
