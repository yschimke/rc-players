{
  "name": "resize_flow_wrap",
  "description": "Flow layout responsive line-wrapping reflow across dynamic viewport resizes",
  "parameters": {
    "width": 350,
    "height": 200,
    "density": 1,
    "tolerance": 0.5,
    "frames": 2,
    "resize_steps": [
      {
        "step": 0,
        "width": 350,
        "height": 200,
        "label": "single_line_fit"
      },
      {
        "step": 1,
        "width": 230,
        "height": 200,
        "label": "wrap_one_item"
      },
      {
        "step": 2,
        "width": 110,
        "height": 200,
        "label": "wrap_all_items"
      },
      {
        "step": 3,
        "width": 350,
        "height": 200,
        "label": "restore_single_line"
      }
    ]
  },
  "document": {
    "header": {
      "width": 350,
      "height": 200,
      "contentDescription": "resize_flow_wrap",
      "profiles": 513
    },
    "root": {
      "type": "flow",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
