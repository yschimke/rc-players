{
  "name": "state_layout_expandable_card",
  "category": "layout",
  "description": "Expandable card using StateLayout with nested click handlers in each state. State 0 is collapsed (height 44) with an expand button; State 1 is expanded (height 120) with content and a collapse button. Sibling below is pushed down when expanded and returned when collapsed.",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "interactions": [
      {
        "step": 0,
        "type": "click",
        "x": 130,
        "y": 22,
        "label": "click_expand_card"
      },
      {
        "step": 1,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_on_expanded_state"
      },
      {
        "step": 2,
        "type": "click",
        "x": 130,
        "y": 98,
        "label": "click_collapse_card"
      },
      {
        "step": 3,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_on_collapsed_state"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300
    },
    "resources": {
      "variables": {
        "expandedState": {
          "type": "integer",
          "value": 0
        }
      }
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#020617"
        }
      ],
      "children": [
        {
          "type": "stateLayout",
          "stateId": "$expandedState",
          "children": [
            {
              "type": "box",
              "name": "card_collapsed",
              "modifiers": [
                {
                  "width": 260
                },
                {
                  "height": 44
                },
                {
                  "background": "#1e293b"
                },
                {
                  "onClick": {
                    "type": "valueIntegerChange",
                    "target": "expandedState",
                    "value": 1
                  }
                }
              ]
            },
            {
              "type": "column",
              "name": "card_expanded",
              "modifiers": [
                {
                  "width": 260
                },
                {
                  "height": 120
                },
                {
                  "background": "#0f172a"
                }
              ],
              "children": [
                {
                  "type": "box",
                  "name": "expanded_content",
                  "modifiers": [
                    {
                      "width": 260
                    },
                    {
                      "height": 76
                    },
                    {
                      "background": "#334155"
                    }
                  ]
                },
                {
                  "type": "box",
                  "name": "collapse_button",
                  "modifiers": [
                    {
                      "width": 260
                    },
                    {
                      "height": 44
                    },
                    {
                      "background": "#475569"
                    },
                    {
                      "onClick": {
                        "type": "valueIntegerChange",
                        "target": "expandedState",
                        "value": 0
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "box",
          "name": "sibling_item",
          "modifiers": [
            {
              "width": 260
            },
            {
              "height": 40
            },
            {
              "background": "#64748b"
            }
          ]
        }
      ]
    }
  }
}
