{
  "name": "column_weights",
  "description": "Column layout distributing remaining vertical height among weighted children",
  "parameters": {
    "width": 200,
    "height": 500,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 500,
        "label": "initial (200x500)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 1000,
        "label": "doubled (400x1000)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 500
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "height": 100
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "weight": 1.0
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 100
            },
            {
              "weight": 3.0
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
