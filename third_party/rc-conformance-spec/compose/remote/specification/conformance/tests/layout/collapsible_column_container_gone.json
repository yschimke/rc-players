            {
              "height": 80
            },
            {
              "background": "#93c5fd"
            },
            {
              "collapsiblePriority": {
                "orientation": "vertical",
                "priority": 100
              }
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 60
            },
            {
              "height": 80
            },
            {
              "background": "#fca5a5"
            },
            {
              "collapsiblePriority": {
                "orientation": "vertical",
                "priority": 50
              }
            }
          ]
        }
      ]
    }
  }
}
