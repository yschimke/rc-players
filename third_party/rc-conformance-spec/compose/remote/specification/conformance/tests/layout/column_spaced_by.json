{
  "name": "column_spaced_by",
  "description": "Column layout with spacedBy modifier distributing inter-item gaps",
  "parameters": {
    "width": 250,
    "height": 400,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 250,
        "height": 400,
        "label": "initial (250x400)"
      },
      {
        "step": 1,
        "width": 500,
        "height": 800,
        "label": "doubled (500x800)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 250,
      "height": 400
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "spacedBy": 15.0
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "height": 60
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "height": 70
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
