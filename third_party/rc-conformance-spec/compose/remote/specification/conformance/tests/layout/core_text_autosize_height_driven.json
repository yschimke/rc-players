{
  "name": "core_text_autosize_height_driven",
  "description": "CoreText autosize constrained by container height rather than width",
  "parameters": {
    "width": 500,
    "height": 24,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 500,
        "height": 24,
        "label": "initial (500x24)"
      },
      {
        "step": 1,
        "width": 1000,
        "height": 48,
        "label": "doubled (1000x48)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 500,
      "height": 24,
      "profiles": 513
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "text",
          "text": "Autosize Height",
          "autoSize": true,
          "minFontSize": 10,
          "maxFontSize": 80,
          "modifiers": [
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
