{
  "name": "row_wrap_content",
  "description": "Row wrapping its content width and height based on child dimensions",
  "parameters": {
    "width": 500,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 500,
        "height": 300,
        "label": "initial (500x300)"
      },
      {
        "step": 1,
        "width": 1000,
        "height": 600,
        "label": "doubled (1000x600)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 500,
      "height": 300
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "row",
          "modifiers": [
            {
              "wrapContentSize": true
            },
            {
              "background": "#1e3a8a"
            }
          ],
          "children": [
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 90
                },
                {
                  "height": 70
                },
                {
                  "background": "#93c5fd"
                }
              ]
            },
            {
              "type": "box",
              "modifiers": [
                {
                  "width": 110
                },
                {
                  "height": 50
                },
                {
                  "background": "#fca5a5"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
