{
  "name": "interaction_scroll_column",
  "description": "Column vertical touch drag gesture scrolling overflowing children items",
  "parameters": {
    "width": 200,
    "height": 120,
    "density": 1.0,
    "tolerance": 0.5,
    "frames": 2,
    "interactions": [
      {
        "step": 0,
        "type": "touch_down",
        "x": 50,
        "y": 80,
        "label": "touch_down"
      },
      {
        "step": 1,
        "type": "touch_drag",
        "x": 50,
        "y": 40,
        "label": "drag_up_40px"
      },
      {
        "step": 2,
        "type": "touch_up",
        "x": 50,
        "y": 40,
        "dx": 0,
        "dy": -40,
        "label": "release"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 120
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "verticalScroll": {
            "position": 0.0,
            "notches": 0
          }
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 60
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 60
            },
            {
              "background": "#fca5a5"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 60
            },
            {
              "background": "#86efac"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 60
            },
            {
              "background": "#fcd34d"
            }
          ]
        }
      ]
    }
  }
}
