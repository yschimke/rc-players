{
  "name": "state_layout_child_constraints",
  "description": "StateLayout child with widthIn and heightIn constraints",
  "parameters": {
    "width": 200,
    "height": 200,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 200,
        "label": "initial (200x200)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 400,
        "label": "doubled (400x400)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 200
    },
    "root": {
      "type": "stateLayout",
      "index": 0,
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "widthIn": {
                "min": 50,
                "max": 140
              }
            },
            {
              "heightIn": {
                "min": 50,
                "max": 140
              }
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
