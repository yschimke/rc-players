{
  "name": "modifier_border_padding",
  "description": "Box styling combining border and inner padding modifiers",
  "parameters": {
    "width": 200,
    "height": 200,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 200,
        "label": "initial (200x200)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 400,
        "label": "doubled (400x400)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 200
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "border": {
            "width": 4.0,
            "cornerRadius": 0.0,
            "color": "#3b82f6"
          }
        },
        {
          "padding": 16
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "fillMaxSize": 1.0
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
