{
  "name": "interaction_touch_down_up_press",
  "category": "layout",
  "description": "Touch down and touch up press-release interaction. onTouchDown sets pressedState to 1 revealing a press indicator, and onTouchUp restores pressedState to 0 collapsing it back to GONE.",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "interactions": [
      {
        "step": 0,
        "type": "touch_down",
        "x": 75,
        "y": 25,
        "label": "press_down_on_button"
      },
      {
        "step": 1,
        "type": "advance_time",
        "delta_millis": 1000,
        "label": "settled_while_pressed"
      },
      {
        "step": 2,
        "type": "touch_up",
        "x": 75,
        "y": 25,
        "label": "release_up_from_button"
      },
      {
        "step": 3,
        "type": "advance_time",
        "delta_millis": 1000,
        "label": "settled_after_release"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300
    },
    "resources": {
      "variables": {
        "pressedState": {
          "type": "integer",
          "value": 0
        }
      }
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#0f172a"
        }
      ],
      "children": [
        {
          "type": "box",
          "name": "touch_button",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 50
            },
            {
              "background": "#3b82f6"
            },
            {
              "onTouchDown": [
                {
                  "type": "valueIntegerChange",
                  "target": "pressedState",
                  "value": 1
                }
              ]
            },
            {
              "onTouchUp": [
                {
                  "type": "valueIntegerChange",
                  "target": "pressedState",
                  "value": 0
                }
              ]
            }
          ]
        },
        {
          "type": "box",
          "name": "pressed_indicator",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 50
            },
            {
              "background": "#ef4444"
            },
            {
              "visibility": "$pressedState"
            }
          ]
        },
        {
          "type": "box",
          "name": "footer_box",
          "modifiers": [
            {
              "width": 150
            },
            {
              "height": 40
            },
            {
              "background": "#64748b"
            }
          ]
        }
      ]
    }
  }
}
