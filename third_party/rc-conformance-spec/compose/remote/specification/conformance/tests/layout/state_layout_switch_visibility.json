{
  "name": "state_layout_switch_visibility",
  "category": "layout",
  "description": "Switch widget combining StateLayout thumb animation with external component visibility toggling (pattern from SwitchWidget demo). Clicking switch toggles switchState, transitioning StateLayout from OFF to ON, and revealing an external details panel with visibility=$switchState.",
  "parameters": {
    "width": 300,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "interactions": [
      {
        "step": 0,
        "type": "click",
        "x": 30,
        "y": 16,
        "label": "click_toggle_switch_on"
      },
      {
        "step": 1,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_with_details_visible"
      },
      {
        "step": 2,
        "type": "click",
        "x": 30,
        "y": 16,
        "label": "click_toggle_switch_off"
      },
      {
        "step": 3,
        "type": "advance_time",
        "delta_millis": 2000,
        "label": "settled_with_details_hidden"
      }
    ]
  },
  "document": {
    "header": {
      "width": 300,
      "height": 300
    },
    "resources": {
      "variables": {
        "switchState": {
          "type": "integer",
          "value": 0
        }
      }
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#0f172a"
        }
      ],
      "children": [
        {
          "type": "box",
          "name": "switch_button",
          "modifiers": [
            {
              "width": 64
            },
            {
              "height": 32
            },
            {
              "onClick": {
                "type": "valueIntegerExpressionChange",
                "target": "switchState",
                "expression": "1 - switchState"
              }
            }
          ],
          "children": [
            {
              "type": "stateLayout",
              "stateId": "$switchState",
              "children": [
                {
                  "type": "box",
                  "name": "switch_track_off",
                  "modifiers": [
                    {
                      "width": 64
                    },
                    {
                      "height": 32
                    },
                    {
                      "background": "#475569"
                    }
                  ],
                  "children": [
                    {
                      "type": "box",
                      "name": "thumb_off",
                      "modifiers": [
                        {
                          "width": 24
                        },
                        {
                          "height": 24
                        },
                        {
                          "offset": {
                            "x": 4,
                            "y": 4
                          }
                        },
                        {
                          "background": "#f8fafc"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "box",
                  "name": "switch_track_on",
                  "modifiers": [
                    {
                      "width": 64
                    },
                    {
                      "height": 32
                    },
                    {
                      "background": "#2563eb"
                    }
                  ],
                  "children": [
                    {
                      "type": "box",
                      "name": "thumb_on",
                      "modifiers": [
                        {
                          "width": 24
                        },
                        {
                          "height": 24
                        },
                        {
                          "offset": {
                            "x": 36,
                            "y": 4
                          }
                        },
                        {
                          "background": "#ffffff"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "box",
          "name": "details_panel",
          "modifiers": [
            {
              "width": 220
            },
            {
              "height": 80
            },
            {
              "background": "#1e3a8a"
            },
            {
              "visibility": "$switchState"
            }
          ]
        },
        {
          "type": "box",
          "name": "footer_info",
          "modifiers": [
            {
              "width": 220
            },
            {
              "height": 30
            },
            {
              "background": "#334155"
            }
          ]
        }
      ]
    }
  }
}
