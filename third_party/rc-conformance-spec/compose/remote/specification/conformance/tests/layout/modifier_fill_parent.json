{
  "name": "modifier_fill_parent",
  "description": "Child sized proportionally with fillParentMaxWidth and fillParentMaxHeight",
  "parameters": {
    "width": 400,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 400,
        "height": 300,
        "label": "initial (400x300)"
      },
      {
        "step": 1,
        "width": 800,
        "height": 600,
        "label": "doubled (800x600)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 400,
      "height": 300
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "fillParentMaxWidth": 0.6
            },
            {
              "fillParentMaxHeight": 0.5
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
