{
  "name": "flow_child_offset",
  "description": "Flow layout items shifted via offset modifiers",
  "parameters": {
    "width": 250,
    "height": 180,
    "density": 1,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 250,
        "height": 180,
        "label": "initial (250x180)"
      },
      {
        "step": 1,
        "width": 500,
        "height": 360,
        "label": "doubled (500x360)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 250,
      "height": 180,
      "contentDescription": "flow_child_offset",
      "profiles": 513
    },
    "root": {
      "type": "flow",
      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#fca5a5"
            },
            {
              "offset": [
                10,
                15
              ]
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#86efac"
            }
          ]
        }
      ]
    }
  }
}
