{
  "name": "modifier_align_by_baseline",
  "description": "Row with alignByBaseline alignment modifier on children",
  "parameters": {
    "width": 400,
    "height": 150,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 400,
        "height": 150,
        "label": "initial (400x150)"
      },
      {
        "step": 1,
        "width": 800,
        "height": 300,
        "label": "doubled (800x300)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 400,
      "height": 150
    },
    "root": {
      "type": "row",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 80
            },
            {
              "height": 60
            },
            {
              "background": "#93c5fd"
            },
            {
              "alignByBaseline": true
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 120
            },
            {
              "height": 90
            },
            {
              "background": "#fca5a5"
            },
            {
              "alignByBaseline": true
            }
          ]
        }
      ]
    }
  }
}
