{
  "name": "box_background_border_container",
  "description": "Box container with background and border styling",
  "parameters": {
    "width": 200,
    "height": 200,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 200,
        "label": "initial (200x200)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 400,
        "label": "doubled (400x400)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 200
    },
    "root": {
      "type": "box",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#0284c7"
        },
        {
          "border": {
            "width": 3.0,
            "cornerRadius": 10.0,
            "color": "#bae6fd"
          }
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 80
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
