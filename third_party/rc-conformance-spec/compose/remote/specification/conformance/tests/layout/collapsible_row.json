{
  "name": "collapsible_row",
  "description": "CollapsibleRow displaying children according to priority threshold",
  "parameters": {
    "width": 200,
    "height": 100,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 200,
        "height": 100,
        "label": "initial (200x100)"
      },
      {
        "step": 1,
        "width": 400,
        "height": 200,
        "label": "doubled (400x200)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 200,
      "height": 100
    },
    "root": {
      "type": "collapsibleRow",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#93c5fd"
            },
            {
              "collapsiblePriority": 1
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#fca5a5"
            },
            {
              "collapsiblePriority": 2
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "width": 90
            },
            {
              "height": 50
            },
            {
              "background": "#86efac"
            },
            {
              "collapsiblePriority": 3
            }
          ]
        }
      ]
    }
  }
}
