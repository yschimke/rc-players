      "modifiers": [
        {
          "fillMaxSize": 1
        },
        {
          "background": "#1e293b"
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "weight": 1
            },
            {
              "fillMaxHeight": 1
            },
            {
              "background": "#93c5fd"
            }
          ]
        },
        {
          "type": "box",
          "modifiers": [
            {
              "weight": 2
            },
            {
              "fillMaxHeight": 1
            },
            {
              "background": "#fca5a5"
            }
          ]
        }
      ]
    }
  }
}
