{
  "name": "resize_row_weights",
  "description": "Row proportional weight distribution responding dynamically to width resize changes",
  "parameters": {
    "width": 300,
    "height": 100,
    "density": 1,
    "tolerance": 0.5,
    "frames": 2,
    "resize_steps": [
      {
        "step": 0,
        "width": 300,
        "height": 100,
        "label": "standard_300"
      },
      {
        "step": 1,
        "width": 600,
        "height": 100,
        "label": "expanded_600"
      },
      {
        "step": 2,
        "width": 150,
        "height": 100,
        "label": "compressed_150"
      }
    ]
  },
  "document": {
