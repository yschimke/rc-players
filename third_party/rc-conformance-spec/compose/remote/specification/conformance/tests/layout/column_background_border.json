{
  "name": "column_background_border",
  "description": "Column container with background and border styling",
  "parameters": {
    "width": 150,
    "height": 300,
    "density": 1.0,
    "frames": 2,
    "tolerance": 0.5,
    "resize_steps": [
      {
        "step": 0,
        "width": 150,
        "height": 300,
        "label": "initial (150x300)"
      },
      {
        "step": 1,
        "width": 300,
        "height": 600,
        "label": "doubled (300x600)"
      }
    ]
  },
  "document": {
    "header": {
      "width": 150,
      "height": 300
    },
    "root": {
      "type": "column",
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#1e293b"
        },
        {
          "border": {
            "width": 2.0,
            "cornerRadius": 8.0,
            "color": "#64748b"
          }
        }
      ],
      "children": [
        {
          "type": "box",
          "modifiers": [
            {
              "size": 50
            },
            {
              "background": "#93c5fd"
            }
          ]
        }
      ]
    }
  }
}
