{
  "name": "conditional_skip_api_gate",
  "category": "conditionals",
  "description": "SKIP (op 241) API gating at parse time: each of api_less_than / api_greater_than / api_equal_to / api_not_equal_to is exercised both true and false against the player's API level 7; skipped operations must be absent from the decoded document and the trailing DrawRect proves the skip byte ranges stayed aligned",
  "parameters": {
    "width": 400,
    "height": 400
  },
  "document": {
    "header": {
      "width": 400,
      "height": 400,
      "contentDescription": "conditional_skip_api_gate",
      "profiles": 513
    },
    "root": [
      {
        "canvas": {
          "modifiers": [
            "fillMaxSize"
          ],
          "commands": [
            {
              "skip": {
                "condition": "api_less_than",
                "value": 99,
                "commands": [
                  {
                    "drawCircle": {
                      "cx": 10,
                      "cy": 10,
                      "radius": 4
                    }
                  }
                ]
              }
            },
            {
              "skip": {
                "condition": "api_greater_than",
                "value": 3,
                "commands": [
                  {
                    "drawOval": {
                      "left": 10,
                      "top": 10,
                      "right": 40,
                      "bottom": 40
                    }
                  }
                ]
              }
            },
            {
              "skip": {
                "condition": "api_equal_to",
                "value": 7,
                "commands": [
                  {
                    "drawLine": {
                      "x1": 0,
                      "y1": 0,
                      "x2": 50,
                      "y2": 50
                    }
                  }
                ]
              }
            },
            {
              "skip": {
                "condition": "api_less_than",
                "value": 1,
                "commands": [
                  {
                    "drawRoundRect": {
                      "left": 60,
                      "top": 60,
                      "right": 120,
                      "bottom": 120,
                      "rx": 8,
                      "ry": 8
                    }
                  }
                ]
              }
            },
            {
              "skip": {
                "condition": "api_not_equal_to",
                "value": 7,
                "commands": [
                  {
                    "drawArc": {
                      "left": 140,
                      "top": 140,
                      "right": 200,
                      "bottom": 200,
                      "startAngle": 0,
                      "sweepAngle": 90
                    }
                  }
                ]
              }
            },
            {
              "drawRect": {
                "left": 0,
                "top": 380,
                "right": 400,
                "bottom": 400
              }
            }
          ]
        }
      }
    ]
  }
}
