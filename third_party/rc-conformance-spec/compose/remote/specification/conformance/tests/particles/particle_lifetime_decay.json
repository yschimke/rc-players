{
  "name": "particle_lifetime_decay",
  "category": "particles",
  "description": "Finite particle lifespan with fade-out alpha factor and state advancement",
  "parameters": {
    "count": 6,
    "variables": [
      "x",
      "y",
      "vx",
      "vy",
      "life"
    ],
    "frames": 6,
    "tolerance": 0.01
  },
  "document": {
    "header": {
      "width": 200,
      "height": 200
    },
    "root": {
      "type": "canvas",
      "commands": [
        {
          "createParticles": {
            "id": "ps",
            "count": 6,
            "variables": [
              "x",
              "y",
              "vx",
              "vy",
              "life"
            ],
            "initialValues": [
              "50",
              "50",
              "1.5 + a[0] * 0.5",
              "2.0 + a[0] * 0.3",
              "1.0"
            ]
          }
        },
        {
          "particlesLoop": {
            "system": "@ps",
            "equations": [
              "x + vx",
              "y + vy",
              "vx",
              "vy",
              "max(0, life - 0.15)"
            ],
            "commands": [
              {
                "drawCircle": {
                  "cx": "x",
                  "cy": "y",
                  "radius": "life * 4"
                }
              }
            ]
          }
        }
      ]
    }
  }
}