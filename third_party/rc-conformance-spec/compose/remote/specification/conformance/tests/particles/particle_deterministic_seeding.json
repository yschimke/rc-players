{
  "name": "particle_deterministic_seeding",
  "category": "particles",
  "description": "Deterministic seeding of 8 particles with distinct initial states derived from particle index",
  "parameters": {
    "count": 8,
    "variables": [
      "x",
      "y",
      "vx",
      "vy"
    ],
    "frames": 2,
    "tolerance": 0.01
  },
  "document": {
    "header": {
      "width": 200,
      "height": 200
    },
    "root": {
      "type": "canvas",
      "commands": [
        {
          "createParticles": {
            "id": "ps",
            "count": 8,
            "variables": [
              "x",
              "y",
              "vx",
              "vy"
            ],
            "initialValues": [
              "15 + a[0] * 20",
              "25 + a[0] * 15",
              "1.0 + a[0] * 0.25",
              "0.5 + a[0] * 0.1"
            ]
          }
        },
        {
          "particlesLoop": {
            "system": "@ps",
            "equations": [
              "x + vx",
              "y + vy",
              "vx",
              "vy"
            ],
            "commands": [
              {
                "drawCircle": {
                  "cx": "x",
                  "cy": "y",
                  "radius": 2
                }
              }
            ]
          }
        }
      ]
    }
  }
}