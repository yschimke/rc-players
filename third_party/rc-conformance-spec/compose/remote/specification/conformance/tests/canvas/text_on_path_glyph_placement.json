                "x": 380,
                "y": 100
              }
            },
            {
              "drawTextOnPath": {
                "text": "ABC",
                "path": "horiz",
                "hOffset": 12,
                "vOffset": -4
              }
            },
            {
              "pathCreate": {
                "id": "vert",
                "x": 200,
                "y": 20
              }
            },
            {
              "pathAppendLineTo": {
                "path": "vert",
                "x": 200,
                "y": 380
              }
            },
            {
              "drawTextOnPath": {
                "text": "XYZ",
                "path": "vert",
                "hOffset": 10,
                "vOffset": 6
              }
            }
          ]
        }
      }
    ]
  }
}
