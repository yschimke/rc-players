{
  "name": "canvas_arc_and_sector",
  "category": "canvas",
  "description": "Angular drawing primitives: drawArc outline and drawSector filled wedge with start angle and sweep",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "document": {
    "header": {
      "apiLevel": 7,
      "width": 300,
      "height": 300
    },
    "root": [
      {
        "canvas": {
          "modifiers": [
            "fillMaxSize"
          ],
          "commands": [
            {
              "paint": {
                "ops": [
                  {
                    "color": "#06B6D4",
                    "style": "stroke",
                    "strokeWidth": 8
                  }
                ]
              }
            },
            {
              "drawArc": {
                "left": 30,
                "top": 30,
                "right": 270,
                "bottom": 270,
                "startAngle": 45,
                "sweepAngle": 270
              }
            },
            {
              "paint": {
                "ops": [
                  {
                    "color": "#F43F5E",
                    "style": "fill"
                  }
                ]
              }
            },
            {
              "drawSector": {
                "left": 70,
                "top": 70,
                "right": 230,
                "bottom": 230,
                "startAngle": 0,
                "sweepAngle": 120
              }
            }
          ]
        }
      }
    ]
  }
}