{
  "name": "animation_box_offset",
  "category": "layout",
  "description": "Multi-frame bounds animation interpolating Box dimensions and child centered position across 4 motion frames",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 100,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "animation": {
      "capture_frames": [
        0,
        5,
        10,
        18
      ],
      "total_frames": 18,
      "trigger": {
        "width": 300,
        "height": 200,
        "type": "resize"
      }
    },
    "density": 1
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "trigger",
      "kind": "trigger",
      "capture": false,
      "trigger": {
        "width": 300,
        "height": 200,
        "type": "resize"
      }
    },
    {
      "id": "animate",
      "kind": "frame_sequence",
      "capture": [
        0,
        5,
        10,
        18
      ],
      "base_time_millis": 10000,
      "total_frames": 18
    }
  ],
