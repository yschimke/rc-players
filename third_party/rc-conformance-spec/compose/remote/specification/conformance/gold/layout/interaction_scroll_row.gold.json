        "y": 50,
        "type": "touch_down"
      },
      {
        "label": "drag_left_40px",
        "step": 1,
        "x": 40,
        "y": 50,
        "type": "touch_drag"
      },
      {
        "label": "release",
        "step": 2,
        "x": 40,
        "y": 50,
        "dx": -40,
        "dy": 0,
        "type": "touch_up"
      }
    ]
  },
