{
  "name": "column_multi_weights",
  "category": "layout",
  "description": "Column dividing available height according to 1:2:3 fractional weights",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 120,
    "height": 360,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (120x360)",
        "step": 0,
        "width": 120,
        "height": 360
      },
      {
        "label": "doubled (240x720)",
        "step": 1,
        "width": 240,
        "height": 720
      }
    ]
  },
