        "label": "initial_touch",
        "step": 0,
        "x": 100,
        "y": 120,
        "type": "touch_down"
      },
      {
        "label": "drag_step_1",
        "step": 1,
        "x": 100,
        "y": 80,
        "type": "touch_drag"
      },
      {
        "label": "drag_step_2",
        "step": 2,
        "x": 100,
        "y": 40,
        "type": "touch_drag"
      },
      {
        "label": "touch_finish",
        "step": 3,
        "x": 100,
        "y": 40,
        "dx": 0,
        "dy": -80,
        "type": "touch_up"
      }
    ]
  },
