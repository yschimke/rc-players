{
  "name": "modifier_marquee_ticker",
  "category": "layout",
  "description": "Marquee modifier scrolls overflowing text over time: the offset stays at rest through the initial delay, then sweeps out to the full overflow distance and back over one cycle",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "animation": {
      "capture_frames": [
        0,
        30,
        60,
        90,
        150,
        210,
        240
      ],
      "total_frames": 240
    },
    "density": 1
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
