{
  "name": "state_layout_nested_boxes_control",
  "category": "layout",
  "description": "Control for state_layout_shared_element_nested_ids: byte-for-byte the same document with every animationId removed, so no shared-element recopy can run. Three concentric centered boxes must lay out as 120x120 at (0,0), 60x60 at (30,30) and 24x24 at (18,18). Any difference between this gold and the shared-element variant is attributable solely to the shared-element measure recopy.",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 200,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "interactions": [
      {
        "label": "switch_to_state_1",
        "step": 0,
        "x": 100,
        "y": 20,
        "type": "click"
      },
      {
        "label": "settled_on_state_1",
        "step": 1,
        "delta_millis": 2000,
        "type": "advance_time"
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
