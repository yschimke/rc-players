{
  "name": "state_layout_shared_element_nested_ids",
  "category": "layout",
  "description": "A StateLayout state whose nested components all declare the same shared-element animationId. State 0 is three concentric centered boxes (120x120, 60x60, 24x24) that every carry animationId 700; state 1 is a single 40x40 box with the same id. findAnimatedComponents keeps only the last component it sees per state, so the slot for id 700 in state 0 is the innermost box - a descendant of the other two. The shared-element measure recopy must not stamp an ancestor's position onto it: the inner boxes stay centered at (30,30) and (18,18) rather than inheriting their parent's offset.",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 200,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "interactions": [
      {
        "label": "switch_to_state_1",
        "step": 0,
        "x": 100,
        "y": 20,
        "type": "click"
      },
      {
        "label": "settled_on_state_1",
        "step": 1,
        "delta_millis": 2000,
        "type": "advance_time"
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2,
      "animation_time_seconds": 10
    },
