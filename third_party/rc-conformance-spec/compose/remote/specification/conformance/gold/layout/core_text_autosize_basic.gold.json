{
  "name": "core_text_autosize_basic",
  "category": "layout",
  "description": "CoreText autosize dynamically scaling single word up to container bounds",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 40,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (200x40)",
        "step": 0,
        "width": 200,
        "height": 40
      },
      {
        "label": "doubled (400x80)",
        "step": 1,
        "width": 400,
        "height": 80
      }
    ]
  },
