        "label": "wrap_one_item",
        "step": 1,
        "width": 230,
        "height": 200
      },
      {
        "label": "wrap_all_items",
        "step": 2,
        "width": 110,
        "height": 200
      },
      {
        "label": "restore_single_line",
        "step": 3,
        "width": 350,
        "height": 200
      }
    ]
  },
