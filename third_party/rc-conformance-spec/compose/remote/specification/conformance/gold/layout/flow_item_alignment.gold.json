{
  "name": "flow_item_alignment",
  "category": "layout",
  "description": "Flow layout with vertical center alignment for varying item heights",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 180,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (200x180)",
        "step": 0,
        "width": 200,
        "height": 180
      },
      {
        "label": "doubled (400x360)",
        "step": 1,
        "width": 400,
        "height": 360
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
