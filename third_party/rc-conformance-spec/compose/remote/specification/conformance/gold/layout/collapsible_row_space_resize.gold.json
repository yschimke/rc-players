{
  "name": "collapsible_row_space_resize",
  "category": "layout",
  "description": "CollapsibleRow dynamically collapsing children as width shrinks and uncollapsing as width expands",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 350,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "all fit (350x100)",
        "step": 0,
        "width": 350,
        "height": 100
      },
      {
        "label": "lowest collapses (220x100)",
        "step": 1,
        "width": 220,
        "height": 100
      },
      {
        "label": "two lowest collapse (120x100)",
        "step": 2,
        "width": 120,
        "height": 100
      },
      {
        "label": "container collapses (50x100)",
        "step": 3,
        "width": 50,
        "height": 100
      },
      {
        "label": "uncollapsed back (350x100)",
        "step": 4,
        "width": 350,
        "height": 100
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
