          "y": 100,
          "width": 70,
          "height": 80,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -6,
          "kind": "BoxLayout",
          "x": 25,
          "y": 100,
          "width": 70,
          "height": 80,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": 25,
          "y": 20,
          "width": 70,
          "height": 80,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "CollapsibleColumnLayout",
          "x": 0,
          "y": 0,
          "width": 120,
          "height": 200,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
