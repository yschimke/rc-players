{
  "name": "collapsible_column_container_gone",
  "category": "layout",
  "description": "CollapsibleColumn where available height cannot accommodate any child, collapsing container to GONE",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 100,
    "height": 40,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "tree",
      "expect": [
        {
          "id": -6,
          "kind": "BoxLayout",
          "x": 20,
          "y": 20,
          "width": 60,
          "height": 80,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": 20,
          "y": 20,
          "width": 60,
          "height": 80,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -3,
          "kind": "CollapsibleColumnLayout",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 40,
          "depth": 1,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 40,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    }
  ],
  "unasserted": [
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    }
  ],
  "document_base64": ""
}