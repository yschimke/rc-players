{
  "name": "state_layout_basic",
  "category": "layout",
  "description": "StateLayout adopts the active state's size (pass-through container): the 120x80 active child sizes the container and the root, and the 200x150 inactive state is kept GONE",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 200,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (300x200)",
        "step": 0,
        "width": 300,
        "height": 200
      },
      {
        "label": "doubled (600x400)",
        "step": 1,
        "width": 600,
        "height": 400
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "resize_0",
      "kind": "resize",
      "label": "initial (300x200)",
      "width": 300,
      "height": 200,
      "frames": 2,
      "animation_enabled": false
    },
    {
      "id": "resize_1",
      "kind": "resize",
      "label": "doubled (600x400)",
      "width": 600,
      "height": 400,
      "frames": 2,
      "animation_enabled": false
    }
  ],
  "checks": [
    {
      "at": "resize_0",
      "probe": "tree",
      "expect": [
        {
          "id": -6,
          "kind": "BoxLayout",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 150,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": 0,
          "y": 0,
          "width": 120,
          "height": 80,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "StateLayout",
          "x": 0,
          "y": 0,
          "width": 120,
          "height": 80,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 200,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
