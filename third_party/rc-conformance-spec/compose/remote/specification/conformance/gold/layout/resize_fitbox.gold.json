          "width": 100,
          "height": 100,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "FitBoxLayout",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 200,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 200,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
