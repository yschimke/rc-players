{
  "name": "resize_fitbox",
  "category": "layout",
  "description": "FitBox uniform aspect ratio preservation and scaling across viewport dimension changes",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 200,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "square_200",
        "step": 0,
        "width": 200,
        "height": 200
      },
      {
        "label": "wide_400",
        "step": 1,
        "width": 400,
        "height": 200
      },
      {
        "label": "tall_300",
        "step": 2,
        "width": 100,
        "height": 300
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "resize_0",
      "kind": "resize",
      "label": "square_200",
      "width": 200,
      "height": 200,
      "frames": 2,
      "animation_enabled": false
    },
    {
      "id": "resize_1",
      "kind": "resize",
      "label": "wide_400",
      "width": 400,
      "height": 200,
      "frames": 2,
      "animation_enabled": false
    },
    {
      "id": "resize_2",
      "kind": "resize",
      "label": "tall_300",
      "width": 100,
      "height": 300,
      "frames": 2,
      "animation_enabled": false
    }
  ],
