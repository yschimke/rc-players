{
  "name": "column_fill_max_width",
  "category": "layout",
  "description": "Column with children filling parent maximum width",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 250,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
