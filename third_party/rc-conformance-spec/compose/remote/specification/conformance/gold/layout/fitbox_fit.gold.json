{
  "name": "fitbox_fit",
  "category": "layout",
  "description": "FitBox whose only candidate is larger than the container: no child fits, so nothing is displayed",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (300x300)",
        "step": 0,
        "width": 300,
        "height": 300
      },
      {
        "label": "doubled (600x600)",
        "step": 1,
        "width": 600,
        "height": 600
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "resize_0",
      "kind": "resize",
      "label": "initial (300x300)",
      "width": 300,
      "height": 300,
      "frames": 2,
      "animation_enabled": false
    },
    {
      "id": "resize_1",
      "kind": "resize",
      "label": "doubled (600x600)",
      "width": 600,
      "height": 600,
      "frames": 2,
      "animation_enabled": false
    }
  ],
  "checks": [
    {
      "at": "resize_0",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": -50,
          "y": 50,
          "width": 400,
          "height": 200,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -3,
          "kind": "FitBoxLayout",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 1,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "resize_1",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": 100,
          "y": 200,
          "width": 400,
          "height": 200,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "FitBoxLayout",
          "x": 0,
          "y": 0,
          "width": 600,
          "height": 600,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 600,
          "height": 600,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "initial",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": -50,
          "y": 50,
          "width": 400,
          "height": 200,
          "depth": 2,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -3,
          "kind": "FitBoxLayout",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 1,
          "isGone": true,
          "visibility": "GONE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "resize_1",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16,
      "advisory": true
    }
  ],
  "unasserted": [
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@resize_0",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    }
  ],
  "document_base64": "AASMAAEAAAABAAAAAAAAAAQABQAEAAABLAAGAAQAAAEsDAkADgAAAApmaXRib3hfZml0AA4ABAAAAgHI\/\/\/\/\/rD\/\/\/\/9\/\/\/\/\/wAAAAIAAAACEAAAAAE\/gAAAQwAAAAE\/gAAANwAAAAAAAAAAAAAAAAAAAAA98PDxPiSkpT5s7O0\/gAAAAAAAAMn\/\/\/\/8yv\/\/\/\/v\/\/\/\/\/AAAAAgAAAAIQAAAAAEPIAABDAAAAAENIAAA3AAAAAAAAAAAAAAAAAAAAAD8Tk5Q\/RcXGP339\/j+AAAAAAAAA1tbW1g=="
}
