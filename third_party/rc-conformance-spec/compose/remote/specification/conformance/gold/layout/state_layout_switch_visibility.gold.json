{
  "name": "state_layout_switch_visibility",
  "category": "layout",
  "description": "Switch widget combining StateLayout thumb animation with external component visibility toggling (pattern from SwitchWidget demo). Clicking switch toggles switchState, transitioning StateLayout from OFF to ON, and revealing an external details panel with visibility=$switchState.",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "interactions": [
      {
        "label": "click_toggle_switch_on",
        "step": 0,
        "x": 30,
        "y": 16,
        "type": "click"
      },
      {
        "label": "settled_with_details_visible",
        "step": 1,
        "delta_millis": 2000,
        "type": "advance_time"
      },
      {
        "label": "click_toggle_switch_off",
        "step": 2,
        "x": 30,
        "y": 16,
        "type": "click"
      },
      {
        "label": "settled_with_details_hidden",
        "step": 3,
        "delta_millis": 2000,
        "type": "advance_time"
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
