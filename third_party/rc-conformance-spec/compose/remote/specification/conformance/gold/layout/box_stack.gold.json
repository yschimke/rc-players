{
  "name": "box_stack",
  "category": "layout",
  "description": "Box container stacking overlapping children with distinct alignments",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (300x300)",
        "step": 0,
        "width": 300,
        "height": 300
      },
      {
        "label": "doubled (600x600)",
        "step": 1,
        "width": 600,
        "height": 600
      }
    ]
  },
