{
  "name": "core_text_autosize_min_clamped",
  "category": "layout",
  "description": "CoreText autosize clamping at minFontSize when container is too small",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 100,
    "height": 30,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (100x30)",
        "step": 0,
        "width": 100,
        "height": 30
      },
      {
        "label": "doubled (200x60)",
        "step": 1,
        "width": 200,
        "height": 60
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "resize_0",
      "kind": "resize",
      "label": "initial (100x30)",
      "width": 100,
      "height": 30,
      "frames": 2,
      "animation_enabled": false
    },
    {
      "id": "resize_1",
      "kind": "resize",
      "label": "doubled (200x60)",
      "width": 200,
      "height": 60,
      "frames": 2,
      "animation_enabled": false
    }
  ],
  "checks": [
    {
      "at": "resize_0",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "CoreText",
          "x": 0,
          "y": 0,
          "width": 58,
          "height": 29,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "BoxLayout",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 30,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 30,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "resize_1",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "CoreText",
          "x": 0,
          "y": 0,
          "width": 118,
          "height": 59,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "BoxLayout",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 60,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 60,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "initial",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "CoreText",
          "x": 0,
          "y": 0,
          "width": 58,
          "height": 29,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "BoxLayout",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 30,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 30,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16,
      "advisory": true
    },
    {
      "at": "resize_0",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16,
      "advisory": true
    },
    {
      "at": "resize_1",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16,
      "advisory": true
    }
