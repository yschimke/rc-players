{
  "name": "canvas_layout_embedded",
  "category": "layout",
  "description": "CanvasLayout embedded custom canvas container with layout bounds and constraint sizing",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "frames": 1,
    "tolerance": 0.5,
    "density": 1
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "tree",
      "expect": [
        {
          "id": -7,
          "kind": "BoxLayout",
          "x": 150,
          "y": 0,
          "width": 150,
          "height": 150,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -5,
          "kind": "CanvasLayout",
          "x": 0,
          "y": 0,
          "width": 150,
          "height": 150,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "RowLayout",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 300,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16,
      "advisory": true
    }
  ],
  "document_base64": ""
}