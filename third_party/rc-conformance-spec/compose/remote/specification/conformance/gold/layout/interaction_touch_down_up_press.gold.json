{
  "name": "interaction_touch_down_up_press",
  "category": "layout",
  "description": "Touch down and touch up press-release interaction. onTouchDown sets pressedState to 1 revealing a press indicator, and onTouchUp restores pressedState to 0 collapsing it back to GONE.",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "interactions": [
      {
        "label": "press_down_on_button",
        "step": 0,
        "x": 75,
        "y": 25,
        "type": "touch_down"
      },
      {
        "label": "settled_while_pressed",
        "step": 1,
        "delta_millis": 1000,
        "type": "advance_time"
      },
      {
        "label": "release_up_from_button",
        "step": 2,
        "x": 75,
        "y": 25,
        "type": "touch_up"
      },
      {
        "label": "settled_after_release",
        "step": 3,
        "delta_millis": 1000,
        "type": "advance_time"
      }
    ]
  },
  "harness": {
    "text_metrics": "ahem"
  },
