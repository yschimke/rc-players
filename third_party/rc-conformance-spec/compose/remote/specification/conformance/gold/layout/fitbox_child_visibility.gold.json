{
  "name": "fitbox_child_visibility",
  "category": "layout",
  "description": "FitBox child with explicit visibility modifier",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 150,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (200x150)",
        "step": 0,
        "width": 200,
        "height": 150
