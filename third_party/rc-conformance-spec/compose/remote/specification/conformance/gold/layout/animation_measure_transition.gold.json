{
  "name": "animation_measure_transition",
  "category": "layout",
  "description": "Multi-frame layout animation measuring position interpolation over time during resize",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "animation": {
      "capture_frames": [
        0,
        6,
        12,
        20
      ],
      "total_frames": 20,
      "trigger": {
        "width": 400,
        "height": 100,
        "type": "resize"
      }
    },
    "density": 1
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
