{
  "name": "animation_measure_transition",
  "category": "layout",
  "description": "Multi-frame layout animation measuring position interpolation over time during resize",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "animation": {
      "capture_frames": [
        0,
        6,
        12,
        20
      ],
      "total_frames": 20,
      "trigger": {
        "width": 400,
        "height": 100,
        "type": "resize"
      }
    },
    "density": 1
  },
  "harness": {
    "text_metrics": "ahem"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2
    },
    {
      "id": "trigger",
      "kind": "trigger",
      "capture": false,
      "trigger": {
        "width": 400,
        "height": 100,
        "type": "resize"
      }
    },
    {
      "id": "animate",
      "kind": "frame_sequence",
      "capture": [
        0,
        6,
        12,
        20
      ],
      "base_time_millis": 10000,
      "total_frames": 20
    }
  ],
  "checks": [
    {
      "at": "frame_0",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
          "kind": "BoxLayout",
          "x": 140,
          "y": 0,
          "width": 60,
          "height": 60,
          "depth": 2,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -3,
          "kind": "RowLayout",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 100,
          "depth": 1,
          "isGone": false,
          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 100,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "frame_6",
      "probe": "tree",
