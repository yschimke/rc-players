          "visibility": "VISIBLE"
        },
        {
          "id": -2,
          "kind": "RootLayoutComponent",
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 200,
          "depth": 0,
          "isGone": false,
          "visibility": "VISIBLE"
        }
      ],
      "tolerance": 0.5
    },
    {
      "at": "resize_1",
      "probe": "tree",
      "expect": [
        {
          "id": -5,
