{
  "name": "state_layout_child_padding",
  "category": "layout",
  "description": "StateLayout active state child with padding modifier",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 200,
    "height": 200,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "initial (200x200)",
        "step": 0,
        "width": 200,
        "height": 200
      },
      {
        "label": "doubled (400x400)",
        "step": 1,
        "width": 400,
        "height": 400
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
