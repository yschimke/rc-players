{
  "name": "resize_collapsible_row",
  "category": "layout",
  "description": "CollapsibleRow responsive priority-based element collapse and restoration during resize",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 100,
    "frames": 2,
    "tolerance": 0.5,
    "density": 1,
    "resize_steps": [
      {
        "label": "all_items_fit",
        "step": 0,
        "width": 300,
        "height": 100
      },
      {
        "label": "collapse_lowest_priority",
        "step": 1,
        "width": 190,
        "height": 100
      },
      {
        "label": "collapse_second_priority",
        "step": 2,
        "width": 100,
        "height": 100
      },
      {
        "label": "restore_all_items",
        "step": 3,
        "width": 300,
        "height": 100
      }
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "ahem"
  },
