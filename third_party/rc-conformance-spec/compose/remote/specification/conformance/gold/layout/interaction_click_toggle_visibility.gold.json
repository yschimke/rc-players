        "x": 60,
        "y": 20,
        "type": "click"
      },
      {
        "label": "settled_after_hide",
        "step": 1,
        "delta_millis": 1000,
        "type": "advance_time"
      },
      {
        "label": "click_show_panel",
        "step": 2,
        "x": 180,
        "y": 20,
        "type": "click"
      },
      {
        "label": "settled_after_show",
        "step": 3,
        "delta_millis": 1000,
        "type": "advance_time"
      }
    ]
  },
