{
  "name": "conditional_skip_api_gate",
  "category": "conditionals",
  "description": "SKIP (op 241) API gating at parse time: each of api_less_than / api_greater_than / api_equal_to / api_not_equal_to is exercised both true and false against the player's API level 7; skipped operations must be absent from the decoded document and the trailing DrawRect proves the skip byte ranges stayed aligned",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 400,
    "height": 400
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "ops",
      "expect": [
        "DrawRoundRect",
        "DrawArc",
        "DrawRect"
      ],
      "channel": "present"
    },
    {
      "at": "initial",
      "probe": "ops",
      "expect": [
        "DrawCircle",
        "DrawOval",
        "DrawLine"
      ],
      "channel": "absent"
    },
    {
      "at": "initial",
      "probe": "ops",
      "expect": {
        "DrawArc": 1,
        "DrawCircle": 0,
        "DrawLine": 0,
        "DrawOval": 0,
        "DrawRect": 1,
        "DrawRoundRect": 1
      },
      "channel": "counts"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": ""
}