{
  "name": "expr_vector_math",
  "category": "expressions",
  "description": "2D Euclidean geometry, vector magnitude, and distance calculations",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "tolerance": 0.001
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "float",
      "target": "dist",
      "expect": 50,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "dot_self",
      "expect": 1,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "dx",
      "expect": 40,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "dy",
      "expect": 30,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "norm_x",
      "expect": 0.8,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "norm_y",
      "expect": 0.6,
      "tolerance": 0.001
    }
  ],
  "unasserted": [
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    }
  ],
