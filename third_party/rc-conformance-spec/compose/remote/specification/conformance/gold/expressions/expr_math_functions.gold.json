      "at": "initial",
      "probe": "float",
      "target": "res_abs_neg",
      "expect": 42.5,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_abs_pos",
      "expect": 17.2,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_clamp_high",
      "expect": 10,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_clamp_low",
      "expect": 10,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_clamp_mid",
      "expect": 10,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_hypot",
      "expect": 5,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_max",
      "expect": 15.5,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_min",
      "expect": 9.2,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_pow",
      "expect": 256,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_sqrt",
      "expect": 12,
      "tolerance": 0.001
    },
    {
      "at": "initial",
      "probe": "float",
      "target": "res_square",
      "expect": 49,
      "tolerance": 0.001
