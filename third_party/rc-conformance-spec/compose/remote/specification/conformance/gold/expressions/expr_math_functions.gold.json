{
  "name": "expr_math_functions",
  "category": "expressions",
  "description": "Core mathematical functions: abs, min, max, clamp, sqrt, pow, hypot, square",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "tolerance": 0.001
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
