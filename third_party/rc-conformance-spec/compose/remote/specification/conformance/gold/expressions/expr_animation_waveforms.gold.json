      "probe": "float",
      "target": "sine_wave",
      "expect": 0,
      "tolerance": 0.005
    },
    {
      "at": "t_1",
      "probe": "float",
      "target": "square_wave",
      "expect": 1,
      "tolerance": 0.005
    },
    {
      "at": "t_1",
      "probe": "float",
      "target": "triangle_wave",
      "expect": 1,
      "tolerance": 0.005
    }
  ],
  "unasserted": [
    {
      "key": "expected_steps[1..4]",
      "reason": "waveform shape over time is not asserted: the v2 timeline has no step kind that advances animation time, so only the t=0 sample survives as a check"
    },
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@t_0",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
