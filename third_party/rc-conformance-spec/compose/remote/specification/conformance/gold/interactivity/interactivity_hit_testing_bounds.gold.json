{
  "name": "interactivity_hit_testing_bounds",
  "category": "interactivity",
  "description": "Spatial hit testing: clicks inside component bounds trigger action, clicks outside return false",
  "format_version": 2,
  "profile": "extended",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    },
    {
      "id": "act_0",
      "kind": "click",
      "label": "outside right",
      "x": 120,
      "y": 30,
      "repaint": false
    },
    {
      "id": "act_1",
      "kind": "click",
      "label": "outside bottom",
      "x": 50,
      "y": 80,
      "repaint": false
    },
    {
      "id": "act_2",
      "kind": "click",
      "label": "outside left",
      "x": -10,
      "y": 30,
      "repaint": false
    },
    {
      "id": "act_3",
      "kind": "click",
      "label": "outside top",
      "x": 50,
      "y": -10,
      "repaint": false
    },
    {
      "id": "act_4",
      "kind": "click",
      "label": "inside center",
      "x": 50,
      "y": 30,
      "repaint": false
    }
  ],
  "checks": [
    {
      "at": "act_0",
      "probe": "trace",
      "expect": false,
      "channel": "handled"
    },
    {
      "at": "act_1",
      "probe": "trace",
      "expect": false,
      "channel": "handled"
    },
    {
      "at": "act_2",
      "probe": "trace",
      "expect": false,
      "channel": "handled"
    },
    {
      "at": "act_3",
      "probe": "trace",
      "expect": false,
      "channel": "handled"
    },
    {
      "at": "act_4",
      "probe": "trace",
      "expect": true,
      "channel": "handled"
    },
    {
      "at": "act_4",
      "probe": "float",
      "target": "hit_count",
      "expect": 1,
      "tolerance": 0.05
    }
  ],
  "unasserted": [
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_0",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_1",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_2",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_3",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_4",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    }
  ],
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAABLAAGAAQAAAEsiQAAACoAAAABAAAACWhpdF9jb3VudFAAAAAqAAAAAMj////+UQAAACsAAAAD/4AAKj+AAAD/sQAByv////3/////AAAAAgAAAALdQkgAAEJIAAAQAAAAAELIAABDAAAAAEJwAAA74wAAACoAAAAr1tbW",
  "expected_final_variables": {
    "hit_count": 1
  },
  "interactions": [
    {
      "x": 120,
      "y": 30,
      "expectedHandled": false,
      "note": "outside right",
      "type": "click"
    },
    {
      "x": 50,
      "y": 80,
      "expectedHandled": false,
      "note": "outside bottom",
      "type": "click"
    },
    {
      "x": -10,
      "y": 30,
      "expectedHandled": false,
      "note": "outside left",
      "type": "click"
    },
    {
      "x": 50,
      "y": -10,
      "expectedHandled": false,
      "note": "outside top",
      "type": "click"
    },
    {
      "x": 50,
      "y": 30,
      "expectedHandled": true,
      "note": "inside center",
      "type": "click"
    }
  ]
}