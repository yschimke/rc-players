{
  "name": "interactivity_click_toggle_state",
  "category": "interactivity",
  "description": "Tap toggle button alternating state between 0 and 1 (active = 1 - active)",
  "format_version": 2,
  "profile": "extended",
  "parameters": {
    "width": 200,
    "height": 200
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    },
    {
      "id": "act_0",
      "kind": "click",
      "x": 100,
      "y": 100,
      "repaint": false
    },
    {
      "id": "act_1",
      "kind": "click",
      "x": 100,
      "y": 100,
      "repaint": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "float",
      "target": "is_active",
      "expect": 0,
      "tolerance": 0.05
    },
    {
      "at": "act_0",
      "probe": "float",
      "target": "is_active",
      "expect": 1,
      "tolerance": 0.05
    },
    {
      "at": "act_0",
      "probe": "trace",
      "expect": true,
      "channel": "handled"
    },
    {
      "at": "act_1",
      "probe": "float",
      "target": "is_active",
      "expect": 0,
      "tolerance": 0.05
    },
    {
      "at": "act_1",
      "probe": "trace",
      "expect": true,
      "channel": "handled"
    }
  ],
  "unasserted": [
    {
      "key": "raster@initial",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_0",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    },
    {
      "key": "raster@act_1",
      "reason": "the document draws nothing at this step, so there is no reference image to compare against"
    }
  ],
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAAAyAAGAAQAAADIiQAAACoAAAABAAAACWlzX2FjdGl2ZVAAAAAqAAAAAMj////+UQAAACsAAAADP4AAAP+AACr/sQACyv////3/////AAAAAgAAAAIQAAAAAX/AAABDAAAAAX/AAAA74wAAACoAAAAr1tbW",
  "expected_final_variables": {
    "is_active": 0
  },
  "interactions": [
    {
      "x": 100,
      "y": 100,
      "expectedHandled": true,
      "expectedVariableAfter": {
        "is_active": 1
      },
      "type": "click"
    },
    {
      "x": 100,
      "y": 100,
      "expectedHandled": true,
      "expectedVariableAfter": {
        "is_active": 0
      },
      "type": "click"
    }
  ]
}