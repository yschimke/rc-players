  "expected_final_variables": {
    "count_double": 1,
    "count_long": 1,
    "count_single": 1
  },
  "interactions": [
    {
      "x": 100,
      "y": 100,
      "expectedHandled": true,
      "type": "click"
    },
    {
      "x": 100,
