{
  "name": "interactivity_slider_touch_expression",
  "category": "interactivity",
  "description": "Accumulating TouchExpression driving a slider position that persists after release",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    },
    {
      "id": "act_0",
      "kind": "touch_down",
      "x": 50,
      "y": 150,
      "repaint": false
    },
    {
      "id": "act_1",
      "kind": "touch_drag",
      "x": 120,
      "y": 150,
      "repaint": false
    },
    {
      "id": "act_2",
      "kind": "touch_drag",
      "x": 180,
      "y": 150,
      "repaint": false
    },
    {
      "id": "act_3",
      "kind": "touch_up",
      "x": 180,
      "y": 150,
      "dx": 20,
      "dy": 0,
      "repaint": false
    }
  ],
  "checks": [
    {
      "at": "act_3",
      "probe": "float",
      "target": 13,
      "expect": 180,
      "tolerance": 0
    },
    {
      "at": "act_3",
      "probe": "float",
      "target": 14,
      "expect": 150,
      "tolerance": 0
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    },
    {
      "at": "act_0",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    },
    {
      "at": "act_1",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    },
    {
      "at": "act_2",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    },
    {
      "at": "act_3",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAABLAAGAAQAAAEsiQAAACoAAAABAAAACnNsaWRlcl9wb3NQAAAAKkJIAADI/////s3////9/////xAAAAABf8AAAEMAAAABf8AAAMn////8z/////udAAAAKwAAAAB/wAAAP4AAAH/AAAAAAAAAAAAAAf+AAA0AAAAAAAAAAFEAAAAsAAAAA/+AACtCIAAA/7EAASr/gAArQwwAAP+AACxDIAAA1tbW1g==",
  "expected_touch_coords": {
    "touchX": 180,
    "touchY": 150
  },
  "interactions": [
    {
      "x": 50,
      "y": 150,
      "type": "touchDown"
    },
    {
      "x": 120,
      "y": 150,
      "type": "touchDrag"
    },
    {
      "x": 180,
      "y": 150,
      "type": "touchDrag"
    },
    {
      "x": 180,
      "y": 150,
      "dx": 20,
      "dy": 0,
      "type": "touchUp"
    }
  ]
}