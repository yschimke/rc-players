{
  "format_version": 2,
  "name": "clock_time_attribute_calendar_date",
  "description": "Validates TimeAttribute (172) extracting calendar day of month (TIME_DAY_OF_MONTH = 9).",
  "category": "clock",
  "profile": "core",
  "harness": {
    "width": 300,
    "height": 300
  },
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAABLAAGAAQAAAEslAAAAAEAAAGLz+VoAJQAAAACAAABi8/WJcCsAAAAFQAAAAEACQAA",
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2,
      "measure": false
    }
  ],
  "checks": [
    {
      "id": "ops_present",
      "at": "initial",
      "probe": "ops",
      "channel": "present",
      "expect": [
        "TimeAttribute"
      ]
    },
    {
      "id": "time_val",
      "at": "initial",
      "probe": "float",
      "target": 21,
      "expect": 14,
      "tolerance": 0.01
    }
  ]
}
