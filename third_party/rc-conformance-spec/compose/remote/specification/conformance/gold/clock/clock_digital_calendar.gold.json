{
  "name": "clock_digital_calendar",
  "category": "clock",
  "description": "Calendar date and epoch variables: dayOfMonth, calendarMonth, year, dayOfWeek, epochSecond",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "tolerance": 50,
    "fixedTimestamp": "2026-09-10T14:30:00Z"
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    },
    {
      "id": "snap_0",
      "kind": "clock_snapshot",
      "label": 1789050600000,
      "clock": {
        "timestamp_millis": 1789050600000
      }
    }
  ],
  "checks": [
    {
      "at": "snap_0",
      "probe": "float",
      "target": "cal_year",
      "expect": 2026,
      "tolerance": 50
    },
    {
      "at": "snap_0",
      "probe": "float",
      "target": "cal_month",
      "expect": 9,
      "tolerance": 50
    },
    {
      "at": "snap_0",
      "probe": "float",
      "target": "cal_day",
      "expect": 10,
      "tolerance": 50
    },
    {
      "at": "snap_0",
      "probe": "float",
      "target": "cal_weekday",
      "expect": 4,
      "tolerance": 50
    },
    {
      "at": "snap_0",
      "probe": "float",
      "target": "cal_epoch",
      "expect": 1789050624,
      "tolerance": 50
    },
    {
      "at": "initial",
      "advisory": true,
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    },
    {
      "at": "snap_0",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "",
  "gold_image_base64": "data:image/png;base64,",
  "snapshots": [
    {
      "expected_variables": {
        "cal_day": 10,
        "cal_epoch": 1789050624,
        "cal_month": 9,
        "cal_weekday": 4,
        "cal_year": 2026
      },
      "gold_image_base64": "data:image/png;base64,",
      "timestampMillis": 1789050600000
    }
  ]
}