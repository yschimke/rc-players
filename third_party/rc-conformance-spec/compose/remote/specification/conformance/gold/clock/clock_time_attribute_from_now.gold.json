{
  "format_version": 2,
  "name": "clock_time_attribute_from_now",
  "description": "Validates TimeAttribute (172) extracting calendar year (TIME_YEAR = 12).",
  "category": "clock",
  "profile": "core",
  "harness": {
    "width": 300,
    "height": 300
  },
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAABLAAGAAQAAAEslAAAAAEAAAGLz+VoAJQAAAACAAABi8/WJcCsAAAAGAAAAAEADAAA",
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 2,
      "measure": false
    }
  ],
  "checks": [
    {
      "id": "ops_present",
      "at": "initial",
      "probe": "ops",
      "channel": "present",
      "expect": [
        "TimeAttribute"
      ]
    },
    {
      "id": "time_val",
      "at": "initial",
      "probe": "float",
      "target": 24,
      "expect": 2023,
      "tolerance": 0.01
    }
  ]
}
