{
  "name": "text_on_path_glyph_placement",
  "category": "canvas",
  "description": "DRAW_TEXT_ON_PATH (53): glyphs are laid out from the path start offset by hOffset, displaced perpendicular to the tangent by vOffset, and rotated to the tangent angle \u2014 checked on a horizontal path (0\u00b0) and a vertical one (90\u00b0) with a real draw recorder",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 400,
    "height": 400
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "records",
      "expect": [
        {
          "label": "horizontal path (20,100)\u2192(380,100), hOffset=12, vOffset=-4",
          "allDeviceY": 96,
          "allRotationsDeg": 0,
          "deviceXOrder": "increasing",
          "firstDeviceX": 32,
          "glyphCount": 3,
          "text": "ABC"
        },
        {
          "label": "vertical path (200,20)\u2192(200,380), hOffset=10, vOffset=6",
          "allDeviceX": 194,
          "allRotationsDeg": 90,
          "deviceYOrder": "increasing",
          "firstDeviceY": 30,
          "glyphCount": 3,
          "text": "XYZ"
        }
      ],
      "tolerance": 0.01,
      "channel": "glyph_runs"
    },
    {
      "at": "initial",
      "probe": "ops",
      "expect": [
        "DrawTextOnPath"
      ],
      "channel": "present"
    },
    {
      "at": "initial",
      "probe": "ops",
      "expect": 6,
      "channel": "total_glyphs"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": ""
}
