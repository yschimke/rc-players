{
  "name": "canvas_path_bezier",
  "category": "canvas",
  "description": "Vector path creation: lineTo, quadratic bezier, cubic bezier, and closed polygon rendering",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "draw_log",
      "expect": [
        "paint",
        "drawPath",
        "paint",
        "drawPath"
      ],
      "channel": "commands"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "",
  "expected_commands": [
    "paint",
    "drawPath",
    "paint",
    "drawPath"
  ],
  "gold_image_base64": "data:image/png;base64,"
}