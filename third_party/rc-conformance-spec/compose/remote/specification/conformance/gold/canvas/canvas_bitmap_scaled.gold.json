{
  "name": "canvas_bitmap_scaled",
  "category": "canvas",
  "description": "Bitmap raster asset decoding, transformation, and scaled destination bounds rendering",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "draw_log",
      "expect": [
        "drawBitmapScaled"
      ],
      "channel": "commands"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "",
  "expected_commands": [
    "drawBitmapScaled"
  ]
}