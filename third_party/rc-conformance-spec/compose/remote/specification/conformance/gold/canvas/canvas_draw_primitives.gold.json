{
  "name": "canvas_draw_primitives",
  "category": "canvas",
  "description": "2D drawing primitives: rect, circle, roundRect, line, oval with styled colors and strokes",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "primitivesCount": 5
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "draw_log",
      "expect": [
        "paint",
        "drawRect",
        "paint",
        "drawCircle",
        "paint",
        "drawRoundRect",
        "paint",
        "drawLine",
        "paint",
        "drawOval"
      ],
      "channel": "commands"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "",
  "expected_commands": [
    "paint",
    "drawRect",
    "paint",
    "drawCircle",
    "paint",
    "drawRoundRect",
    "paint",
    "drawLine",
    "paint",
    "drawOval"
  ],
  "gold_image_base64": "data:image/png;base64,"
}