{
  "name": "canvas_matrix_stack",
  "category": "canvas",
  "description": "Matrix transformations: save, translate, scale, rotate, and restore state stack",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "draw_log",
      "expect": [
        "paint",
        "drawRect",
        "save",
        "translate",
        "rotate",
        "scale",
        "paint",
        "drawRect",
        "restore"
      ],
      "channel": "commands"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
