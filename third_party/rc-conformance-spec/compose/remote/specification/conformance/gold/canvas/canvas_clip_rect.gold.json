{
  "name": "canvas_clip_rect",
  "category": "canvas",
  "description": "Clipping operations: clipRect boundary restricting subsequent overlapping circular drawing",
  "format_version": 2,
  "profile": "core",
  "parameters": {
    "width": 300,
    "height": 300,
    "clipBounds": [
      50,
      50,
      250,
      250
    ]
  },
  "harness": {
    "raster_source": "android-view-player",
    "text_metrics": "native"
  },
  "timeline": [
    {
      "id": "initial",
      "kind": "paint",
      "frames": 1,
      "measure": false
    }
  ],
  "checks": [
    {
      "at": "initial",
      "probe": "draw_log",
      "expect": [
        "paint",
        "drawRect",
        "save",
        "clipRect",
        "paint",
        "drawCircle",
        "paint",
        "drawCircle",
        "restore"
      ],
      "channel": "commands"
    },
    {
      "at": "initial",
      "probe": "raster",
      "expect": "data:image/png;base64,",
      "tolerance": 16
    }
  ],
  "document_base64": "AASMAAEAAAABAAAAAAAAAAIABQAEAAABLAAGAAQAAAEsyP////7N/////f////8QAAAAAX/AAABDAAAAAX/AAADJ/////M/////7KAAAAAUAAAAE/zNBVQABAAgAAAAFQAAAACpCQAAAQkAAAEN8AABDfAAAgidCSAAAQkgAAEN6AABDegAAKAAAAAMAAAAE/+9ERAAAAAguQsgAAELIAABCtAAAKAAAAAMAAAAE/wa21AAAAAguQ1wAAENcAABCoAAAg9bW1tY=",
  "expected_commands": [
    "paint",
    "drawRect",
    "save",
    "clipRect",
    "paint",
    "drawCircle",
    "paint",
    "drawCircle",
    "restore"
  ],
  "gold_image_base64": "data:image/png;base64,"
